rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Projects : lecture publique uniquement si publié, sinon admin seul.
    // Écriture : admin uniquement.
    match /projects/{projectId} {
      allow read: if isAdmin()
        || (resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.published == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Sous-collections éventuelles : admin only.
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Livres : lecture publique si publié, sinon admin. Écriture admin only.
    match /books/{bookId} {
      allow read: if isAdmin()
        || (resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.published == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Liste d'admins : gérée à la main dans la console Firebase.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log : append-only par les admins.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Login history : append-only par tout user authentifié (admin ou pas).
    match /loginHistory/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Scans : réservés à l'admin (debug/qualité). L'app PLAY n'uploade plus
    // aucun scan (vie privée : la photo reste sur l'appareil) → plus de create
    // public. Admin only en lecture comme en écriture.
    match /scans/{scanId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Comptage ANONYME des passages vers les stores depuis picopop.app (fonction /go du site) :
    // création publique, contenu strictement borné (origine, plateforme, pays, langue, date), lecture admin.
    // Événements ANONYMES de l'app play (identifiant d'installation aléatoire, type, livre/coloriage,
    // plateforme, version, langue, jour) : création publique au contenu strictement borné, lecture admin.
    match /appEvents/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['installId', 'type', 'bookId', 'projectId', 'platform', 'appVersion', 'lang', 'day', 'ts'])
        && request.resource.data.keys().hasAll(['installId', 'type', 'platform', 'appVersion', 'lang', 'day', 'ts'])
        && request.resource.data.installId is string && request.resource.data.installId.size() >= 8 && request.resource.data.installId.size() <= 64
        && request.resource.data.type in ['install', 'book_added', 'scan', 'share']
        && (!('bookId' in request.resource.data) || (request.resource.data.bookId is string && request.resource.data.bookId.size() <= 64))
        && (!('projectId' in request.resource.data) || (request.resource.data.projectId is string && request.resource.data.projectId.size() <= 64))
        && request.resource.data.platform in ['ios', 'android', 'web']
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 16
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    match /siteClicks/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['src', 'platform', 'country', 'lang', 'ts', 'day'])
        && request.resource.data.src is string && request.resource.data.src.size() <= 32
        && request.resource.data.platform in ['ios', 'android', 'desktop', 'pdf']
        && request.resource.data.country is string && request.resource.data.country.size() == 2
        && request.resource.data.lang is string && request.resource.data.lang.size() == 2
        && request.resource.data.ts is int && request.resource.data.day is string && request.resource.data.day.size() == 10;
      allow update, delete: if isAdmin();
    }
  }
}
