rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Projects : lecture publique uniquement si publié, sinon admin seul.
    // Écriture : admin uniquement.
    match /projects/{projectId} {
      allow read: if isAdmin()
        || (resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.published == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Sous-collections éventuelles : admin only.
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Liste d'admins : gérée à la main dans la console Firebase.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log : append-only par les admins.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Login history : append-only par tout user authentifié (admin ou pas).
    match /loginHistory/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Scans : créés sans auth par play.NDD (utilisateur final).
    match /scans/{scanId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
