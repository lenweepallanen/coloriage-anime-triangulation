rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Projects : lecture publique uniquement si publié, sinon admin seul.
    // Écriture : admin uniquement.
    match /projects/{projectId} {
      allow read: if isAdmin()
        || (resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.published == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Sous-collections éventuelles : admin only.
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Livres : lecture publique si publié, sinon admin. Écriture admin only.
    match /books/{bookId} {
      allow read: if isAdmin()
        || (resource.data.published == true);
      allow create: if isAdmin()
        && request.resource.data.published == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    // Liste d'admins : gérée à la main dans la console Firebase.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log : append-only par les admins.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Login history : append-only par tout user authentifié (admin ou pas).
    match /loginHistory/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Scans : réservés à l'admin (debug/qualité). L'app PLAY n'uploade plus
    // aucun scan (vie privée : la photo reste sur l'appareil) → plus de create
    // public. Admin only en lecture comme en écriture.
    match /scans/{scanId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Comptage ANONYME des passages vers les stores depuis picopop.app (fonction /go du site) :
    // création publique, contenu strictement borné (origine, plateforme, pays, langue, date), lecture admin.
    match /siteClicks/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['src', 'platform', 'country', 'lang', 'ts', 'day'])
        && request.resource.data.src is string && request.resource.data.src.size() <= 32
        && request.resource.data.platform in ['ios', 'android', 'desktop', 'pdf']
        && request.resource.data.country is string && request.resource.data.country.size() == 2
        && request.resource.data.lang is string && request.resource.data.lang.size() == 2
        && request.resource.data.ts is int && request.resource.data.day is string && request.resource.data.day.size() == 10;
      allow update, delete: if isAdmin();
    }
  }
}
