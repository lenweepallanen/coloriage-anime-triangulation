rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Les Storage Rules ne peuvent pas interroger une base Firestore nommée
    // (limitation Firebase : `firestore.exists()` ne supporte que `(default)`,
    // pas notre base `coloriages`). On se contente donc d'exiger un user
    // authentifié pour les writes sur les assets projet. Le vrai contrôle
    // d'accès admin se fait côté Firestore (qui gate les docs `projects/{id}`),
    // donc un non-admin connecté ne peut pas créer/modifier un projet via
    // l'app.

    // Assets projet : lecture publique (play doit pouvoir charger les vidéos
    // et JSON même sans auth). Écriture : tout user authentifié.
    match /projects/{projectId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Scans : créés sans auth (utilisateur final scanne son coloriage).
    match /scans/{scanId}/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
